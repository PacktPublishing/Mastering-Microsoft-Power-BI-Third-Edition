  <DataSources>
    <DataSource Name="SalesMgmt">
      <rd:SecurityType>None</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/organizations, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-00ac60ba-e356-4fb5-9df3-5750b1210540;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>25bb0298-92da-4775-a34d-c90b62bc364b</rd:DataSourceID>
      <rd:PowerBIWorkspaceName>Sales Management-Dev</rd:PowerBIWorkspaceName>
      <rd:PowerBIDatasetName>Sales Management</rd:PowerBIDatasetName>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsProductCats">
      <Query>
        <DataSourceName>SalesMgmt</DataSourceName>
        <CommandText>EVALUATE
CALCULATETABLE(
VALUES('Product'[Product Category]),
'Product'[Product Category] &lt;&gt; "Undefined"
)</CommandText>
      </Query>
      <Fields>
        <Field Name="ProductCategory">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product[Product Category]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsYears">
      <Query>
        <DataSourceName>SalesMgmt</DataSourceName>
        <CommandText>DEFINE VAR CurrentYear = YEAR(TODAY())
EVALUATE
CALCULATETABLE(
VALUES('Date'[Year]),
'Date'[Year] &gt;= CurrentYear-5 &amp;&amp; 'Date'[Year]&lt;= CurrentYear
)</CommandText>
      </Query>
      <Fields>
        <Field Name="Year">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Date[Year]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsResellerSales">
      <Query>
        <DataSourceName>SalesMgmt</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="pmYear">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pmYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="pmProdCategory">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pmProdCategory.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EVALUATE
SUMMARIZECOLUMNS(
'Product'[Product Category],
'Date'[Year],
RSCustomDaxFilter(@pmYear,EqualToCondition,[Date].[Year],Int64),
RSCustomDaxFilter(@pmProdCategory,EqualToCondition,[Product].[Product Category],String),
"ResellerSalesAmt", [Reseller Sales Amt]
)</CommandText>
      </Query>
      <Fields>
        <Field Name="ProductCategory">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Product[Product Category]</DataField>
        </Field>
        <Field Name="Year">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Date[Year]</DataField>
        </Field>
        <Field Name="ResellerSalesAmt">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[ResellerSalesAmt]</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
